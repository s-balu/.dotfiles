#Own Aliases and other settings.
#Use "source $HOME/.bash_ownConfig.sh" in .bashrc to load

#alias l = "ls -a"
#alias ls = "ls -a"
# alias l="ll -alh"
alias v="vim"

alias tailf="tail -f"

alias tr="tree -L 1"
alias watchme="watch -n 10 \"qstat \""
alias tmux="tmux -f $HOME/.dotfiles/tmux.conf"
alias tls="tmux ls"
alias ta="tmux attach -t"
alias ml="module list"
alias use="du -sh ./"
alias num="lfs find . |wc -l"
alias cl="clear"
alias _meraxes_modules="module purge; module load gcc/11.1.0 openmpi/4.0.2 gsl/2.6  hdf5/1.10.5p   fftw3/3.3.8   cmake/3.18.2; module unload imkl/2019.5.281"
alias _gadget4_modules="module purge; module load python3-as-python openmpi/4.0.1 hdf5/1.10.5 fftw3/3.3.8 gsl/2.6"
alias deets="qstat -fx"
alias rtouch="find . -type f -exec touch {} +"

alias ls="eza --git --grid --icons --no-permissions --no-time --no-user --group-directories-first"
alias l="eza -l --git --grid --icons --no-permissions --no-time --no-user --group-directories-first"
alias lz="eza -l --git --grid --icons --no-permissions --no-time --no-user -all --group-directories-first"
alias lza="eza -l --git --grid --icons --no-permissions --no-time --no-user --total-size -all --group-directories-first"

alias qa="salloc --mem=16G -c 4 -t 06:00:00 srun --pty /bin/zsh -i"
